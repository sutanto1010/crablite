{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (Rust)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--bin",
          "crablite",
          "--manifest-path",
          "${workspaceFolder}/backend/Cargo.toml"
        ],
        "filter": {
          "name": "crablite",
          "kind": "bin"
        }
      },
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "RUST_LOG": "debug",
        "PORT": "3000"
      }
    },
    {
      "name": "Frontend (Vite)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start"
      ],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:[\\s]+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Frontend + Backend",
      "configurations": [
        "Backend (Rust)",
        "Frontend (Vite)"
      ],
      "stopAll": true
    }
  ]
}