{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (cargo run)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin", "crablite"],
        "filter": {
          "name": "crablite",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_LOG": "debug",
        "PORT": "3000"
      }
    }
  ]
}
